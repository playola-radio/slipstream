{
  "name": "@playola-radio/slipstream",
  "version": "0.1.0",
  "description": "Live, honest stream of the file changes a coding agent makes in a worktree, so you can review as it works.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playola-radio/slipstream.git"
  },
  "homepage": "https://github.com/playola-radio/slipstream#readme",
  "bugs": {
    "url": "https://github.com/playola-radio/slipstream/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "slipstream": "./dist/cli.js",
    "slipstream-mcp": "./dist/mcp-forwarder.js"
  },
  "files": [
    "dist",
    "schemas",
    "contracts/interface/v2/schema.json",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 'src/**/!(*.os).test.ts'",
    "test:os": "node --test --test-concurrency=1 'src/**/*.os.test.ts'",
    "test:tools": "node --test --test-concurrency=1 'tools/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "bench": "node src/bench.ts",
    "slipstream": "node src/cli.ts",
    "live-feed": "node tools/live-feed/cli.ts",
    "identity-probe": "node tools/identity-probe/server.ts",
    "bench:clips": "node src/clip-bench.ts",
    "bench:fd5": "node tools/fd5-bench.ts",
    "qa:daemon": "node tools/qa-daemon.ts",
    "qa:check": "node tools/projection-check.ts acceptance",
    "check:fold-release": "node tools/projection-check.ts fold-release",
    "check:package": "node tools/package-check.ts"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
