{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slipstream.dev/schemas/slipstream.capture.gap.v1.json",
  "title": "slipstream.capture.gap.v1",
  "$comment": "An explicit coverage gap: a scope over which observed states may be incomplete. Self-contained; unknown fields permitted for forward compatibility.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "datacontenttype",
    "seq",
    "time",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "source": {
      "type": "string",
      "pattern": "^urn:slipstream:session:"
    },
    "type": {
      "const": "slipstream.capture.gap.v1"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "seq": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "session_id",
        "scope",
        "reason",
        "observed_at_ms"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "reason": {
          "enum": [
            "coalesced",
            "baseline-unreadable",
            "watcher-error",
            "restart",
            "storage"
          ]
        },
        "episode_id": {
          "type": "string"
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "session"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "enum": [
                "directory",
                "path"
              ]
            },
            "path": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
