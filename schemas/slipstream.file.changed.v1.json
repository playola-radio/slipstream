{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slipstream.dev/schemas/slipstream.file.changed.v1.json",
  "title": "slipstream.file.changed.v1",
  "$comment": "An observed transition at a path. `observation` distinguishes a live watcher observation from a restart/recovery reconciliation. Self-contained; unknown fields permitted for forward compatibility. `task_id`/`task_hint_id` will arrive as optional additive data fields in a later stage without a version bump.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "datacontenttype",
    "seq",
    "time",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "source": {
      "type": "string",
      "pattern": "^urn:slipstream:session:"
    },
    "type": {
      "const": "slipstream.file.changed.v1"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "seq": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "session_id",
        "path",
        "before",
        "after",
        "observation",
        "observed_at_ms"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/snapshot"
        },
        "after": {
          "$ref": "#/$defs/snapshot"
        },
        "observation": {
          "enum": [
            "watcher",
            "reconciliation"
          ]
        },
        "coalesced": {
          "type": "boolean"
        },
        "gap_ref": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "snapshot": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "sha256",
            "size"
          ],
          "properties": {
            "kind": {
              "const": "content"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "absent"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "oversize",
                "unreadable",
                "unstable",
                "io-error",
                "baseline-unknown"
              ]
            }
          }
        }
      ]
    }
  }
}
