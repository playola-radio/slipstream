{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slipstream.dev/schemas/slipstream.question.queued.v1.json",
  "title": "slipstream.question.queued.v1",
  "$comment": "A durable queue admission. It acknowledges persistence, never target-harness or model receipt. Self-contained; unknown fields permitted for forward compatibility.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "datacontenttype", "seq", "time", "subject", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "source": { "type": "string", "pattern": "^urn:slipstream:session:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "type": { "const": "slipstream.question.queued.v1" },
    "datacontenttype": { "const": "application/json" },
    "seq": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "time": { "type": "string", "format": "date-time" },
    "subject": { "type": "string", "pattern": "^question/[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "data": {
      "type": "object",
      "required": ["session_id", "question_id", "request_id", "target", "text", "context", "queued_at_ms", "expires_at_ms"],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "question_id": { "$ref": "#/$defs/uuid" },
        "request_id": { "$ref": "#/$defs/uuid" },
        "target": {
          "type": "object",
          "required": ["harness", "harness_session_id", "worktree"],
          "properties": {
            "harness": { "enum": ["claude-code", "codex"] },
            "harness_session_id": { "type": "string", "minLength": 1 },
            "worktree": { "type": "string", "minLength": 1 }
          }
        },
        "text": { "type": "string", "minLength": 1 },
        "context": {
          "type": "object",
          "required": ["change_seq", "path", "snapshot_sha256", "line_start", "line_end", "selected_text"],
          "properties": {
            "change_seq": { "type": "string", "pattern": "^[1-9][0-9]*$" },
            "path": { "type": "string", "minLength": 1 },
            "snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "line_start": { "type": "integer", "minimum": 1 },
            "line_end": { "type": "integer", "minimum": 1 },
            "selected_text": { "type": "string" }
          }
        },
        "queued_at_ms": { "type": "integer", "minimum": 0 },
        "expires_at_ms": { "type": "integer", "minimum": 0 },
        "reply_to_question_id": { "$ref": "#/$defs/uuid" }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
  }
}
