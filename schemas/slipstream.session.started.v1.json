{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slipstream.dev/schemas/slipstream.session.started.v1.json",
  "title": "slipstream.session.started.v1",
  "$comment": "CloudEvents 1.0 envelope. Self-contained by design: GET /v1/schemas/{type} returns everything needed to validate one event type. Unknown fields are permitted deliberately (forward compatibility is a contract).",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "datacontenttype",
    "seq",
    "time",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "source": {
      "type": "string",
      "pattern": "^urn:slipstream:session:"
    },
    "type": {
      "const": "slipstream.session.started.v1"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "seq": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "session_id",
        "root",
        "max_bytes",
        "started_at_ms"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "started_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "capture_ignores": {
          "type": "object",
          "description": "Immutable capture-start ignore policy. Absent means legacy built-in exclusions only. Rule edits and index changes apply only to a new capture.",
          "required": [
            "version",
            "git",
            "slipstreamignore"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "slipstreamignore": {
              "type": [
                "string",
                "null"
              ]
            },
            "git": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "root_prefix",
                    "ignore_case",
                    "sources",
                    "tracked_exceptions"
                  ],
                  "properties": {
                    "root_prefix": {
                      "type": "string"
                    },
                    "ignore_case": {
                      "type": "boolean"
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "dir",
                          "text"
                        ],
                        "properties": {
                          "dir": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "tracked_exceptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
