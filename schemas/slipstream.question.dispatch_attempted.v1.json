{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slipstream.dev/schemas/slipstream.question.dispatch_attempted.v1.json",
  "title": "slipstream.question.dispatch_attempted.v1",
  "$comment": "A durable delivery attempt committed before the hook response. It does not prove receipt or an answer.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "datacontenttype", "seq", "time", "subject", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "source": { "type": "string", "pattern": "^urn:slipstream:session:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "type": { "const": "slipstream.question.dispatch_attempted.v1" },
    "datacontenttype": { "const": "application/json" },
    "seq": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "time": { "type": "string", "format": "date-time" },
    "subject": { "type": "string", "pattern": "^question/[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "data": {
      "type": "object",
      "required": ["session_id", "question_id", "queued_seq", "attempted_at_ms"],
      "properties": {
        "session_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "question_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "queued_seq": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "attempted_at_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
